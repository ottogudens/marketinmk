{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "cd backend && gunicorn config.wsgi --workers 4 --bind 0.0.0.0:$PORT --timeout 120",
    "releaseCommand": "cd backend && python manage.py migrate --noinput && python manage.py collectstatic --noinput",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
